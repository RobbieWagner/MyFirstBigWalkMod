<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
		<!-- Project Properties -->
        <TargetFramework>net6.0</TargetFramework>
        <AssemblyName>MyFirstBigWalkMod</AssemblyName>
        <Description>Mod to test the waters with modding in big walk</Description>
        <Version>0.1.0</Version>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <LangVersion>latest</LangVersion>
        <RestoreAdditionalProjectSources>
            https://api.nuget.org/v3/index.json;
            https://nuget.bepinex.dev/v3/index.json;
            https://nuget.samboy.dev/v3/index.json
        </RestoreAdditionalProjectSources>
        <RootNamespace>MyFirstBigWalkMod</RootNamespace>
    </PropertyGroup>
	
	<ItemGroup>
		<!-- Game Assembly References Here-->
		<BigWalkReference Include="Assembly-CSharp.dll" />
		<BigWalkReference Include="UnityEngine.CoreModule.dll" />
	</ItemGroup>
	
	<ItemGroup>
		<!-- Big Walk Reference Creation Rule -->
		<Reference Include="%(BigWalkReference.Filename)">
			<HintPath>$(BigWalkDir)\BepInEx\interop\%(BigWalkReference.Identity)</HintPath>
			<Private>false</Private>
		</Reference>
	</ItemGroup>

    <ItemGroup>
		<!-- Bepinex -->
        <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.*" IncludeAssets="compile" />
        <PackageReference Include="BepInEx.PluginInfoProps" Version="2.*" />
    </ItemGroup>
</Project>
